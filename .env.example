# URL du backend joignable depuis le navigateur (inlinée dans le bundle client au build).
NEXT_PUBLIC_API_URL=http://localhost:8000
# Optionnel : URL du backend joignable côté serveur uniquement (Server Components/SSR).
# Utile en environnement conteneurisé (docker-compose) où le backend n'est pas exposé
# sous le même nom/port pour le navigateur (hôte) et pour le serveur (réseau interne).
# Sans cette variable, NEXT_PUBLIC_API_URL est aussi utilisée côté serveur.
# INTERNAL_API_URL=http://immo-back:8000
